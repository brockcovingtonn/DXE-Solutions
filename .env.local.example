# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and will never be committed.

# Supabase - found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key - found in Project Settings > API (under "service_role")
# KEEP THIS SECRET. Never expose it to the browser or commit it.
# Used only in server-side admin API routes to create new client logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend - found in your Resend dashboard under API Keys
RESEND_API_KEY=re_your_api_key_here

# Email address that receives estimate request submissions
ESTIMATE_NOTIFICATION_EMAIL=dixie@dxesolutions.com

# The "from" address Resend will send as.
# Must be on a domain you've verified in Resend, or use onboarding@resend.dev for testing
RESEND_FROM_EMAIL=onboarding@resend.dev

# Your site's live URL. Used to build links inside notification emails
# (e.g. "View project" buttons). Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://www.dxesolutions.com

# Google Calendar sync (Admin → Calendar → Connect Google Calendar).
# From a Google Cloud project with the Google Calendar API enabled and an
# OAuth 2.0 Client ID (Web application) — see README.md for the full setup.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must exactly match an "Authorized redirect URI" on that OAuth client.
# Defaults to {NEXT_PUBLIC_SITE_URL}/api/admin/google-calendar/callback if
# not set, but setting it explicitly avoids surprises across environments.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google-calendar/callback

# Anthropic API key, powers the Assistant (Master → Assistant / client
# portal → Assistant). Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Only needed if the key above is "identity-linked" (Anthropic will say so
# in a 400 error: "anthropic-workspace-id is required..."). Find it at
# https://console.anthropic.com/settings/workspaces — click your workspace,
# the ID is in the URL (wrkspc_...). Leave unset for a normal API key.
ANTHROPIC_WORKSPACE_ID=

# Your Google Business Profile's Place ID. Powers the "Share this on
# Google too" prompt shown after a client leaves a 4-5 star review.
# Look it up at https://developers.google.com/maps/documentation/places/web-service/place-id
# (search "DXE Solutions"). Public value, safe to expose client-side —
# it's the same ID Google Maps links use.
NEXT_PUBLIC_GOOGLE_PLACE_ID=your-google-place-id-here
